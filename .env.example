# Match Padel API — environment variables
# Copy to .env and fill in the values.
# Locally use the DEV Supabase project (match-padel-dev), never production.

# Supabase
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# service_role key: server only, bypasses RLS. Never expose it or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# anon key: used only to mint login/register sessions (signInWithPassword),
# isolated from the service_role client above. Never use it for queries.
SUPABASE_ANON_KEY=

# Server
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed origins (no spaces)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Used to build MercadoPago redirect and webhook URLs.
# In deployed environments set both: the code falls back to hardcoded URLs otherwise.
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# MercadoPago (optional for local development; use TEST credentials)
MP_ACCESS_TOKEN=
# Secret shown in the MercadoPago Developers panel after configuring the webhook
# notification URL. Required to verify the `x-signature` header — without it every
# webhook is rejected.
MP_WEBHOOK_SECRET=

# Mercado Pago account of each club (OAuth link, card #74), see docs/mercadopago.md.
# All optional at boot: when any of the four first ones is missing, the club Mercado Pago
# endpoints answer 503 MP_NOT_CONFIGURED and the renewal job does nothing. NOT verified
# against the Mercado Pago sandbox yet (card #73).
# Application ID and client secret of the Mercado Pago Marketplace application
MP_APP_ID=
MP_APP_SECRET=
# Static URL registered in the MP application as Redirect URL. It must be the API callback:
# https://<api-host>/api/v1/mercadopago/oauth/callback
MP_OAUTH_REDIRECT_URI=
# 32 random bytes, base64 (AES-256-GCM key for the stored tokens). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes every stored token unreadable (clubs must link again); never reuse it across environments.
MP_TOKEN_ENCRYPTION_KEY=
# true to send a PKCE S256 code_challenge/code_verifier. Leave unset unless the MP app has PKCE enabled.
MP_OAUTH_PKCE=

# Transactional email (Resend), see docs/email.md. All optional: without
# RESEND_API_KEY the mail module runs in "log" mode and sends nothing.
RESEND_API_KEY=
# Sender. Default: Match Padel <no-reply@matchpadel.com.ar> (the domain must be verified in Resend)
MAIL_FROM=
# send | log. Default: send when RESEND_API_KEY is set, log otherwise
MAIL_MODE=
# development | production. Takes precedence over NODE_ENV for mail: outside production
# subjects get a "[DEV]" prefix. Set it to development on the Render dev service.
APP_ENV=
# Non-production only: redirect every email to this address (original recipient goes in the footer)
MAIL_DEV_RECIPIENT=
# Base URL of the club panel used in email links. Default: https://match-padel-admin.vercel.app
CLUB_PANEL_URL=

# Not used yet (Firebase Admin is not installed)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
